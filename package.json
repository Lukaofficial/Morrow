{
  "name": "morrow",
  "version": "1.0.0",
  "private": true,
  "description": "Morrow \u2014 a fictional European night-train operator. Full-stack booking system.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "setup": "npm run db:seed"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.14",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
